# Copy this file to .env and fill in your own values. Never commit .env.

# RPC endpoint for Sepolia testnet. Get a free one from Alchemy or Infura:
#   https://dashboard.alchemy.com/  or  https://app.infura.io/
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Private key of the wallet that will deploy the contract & pay gas.
# Use a burner/dev wallet funded ONLY with testnet ETH — never a real wallet.
# Get Sepolia ETH from a faucet, e.g. https://www.alchemy.com/faucets/ethereum-sepolia
PRIVATE_KEY=your_wallet_private_key_without_0x_prefix

# Optional: for `npx hardhat verify` on Etherscan
ETHERSCAN_API_KEY=your_etherscan_api_key

# --- Event / mint configuration used by scripts/deploy.js ---
EVENT_NAME="Zeca Arc Live"
EVENT_SYMBOL=ZATIX
BASE_URI=ipfs://REPLACE_WITH_YOUR_METADATA_CID/
MAX_SUPPLY=500
TICKET_PRICE_ETH=0.01
MAX_PER_WALLET=4
# Mint window as unix timestamps. Defaults in deploy.js: starts now, ends in 30 days.
MINT_START=
MINT_END=
